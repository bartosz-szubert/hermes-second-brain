[Unit]
Description=Nightly Hermes and n8n backup to Backblaze B2 (restic)
Wants=network-online.target
After=network-online.target

[Service]
# Give restic a persistent cache: a system service has no HOME, and without
# a cache every run re-downloads index and tree data from the storage.
CacheDirectory=restic
Environment=RESTIC_CACHE_DIR=/var/cache/restic
Type=oneshot
ExecStart=/usr/local/sbin/hermes-backup.sh
Nice=10
IOSchedulingClass=idle
TimeoutStartSec=3h
